rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Helper: isAdmin()
    //
    // Reutilizado por todas las colecciones cuya escritura está
    // restringida a administradores (custom claim "role"). Se
    // define una sola vez acá para que Sprint 3 (mediciones,
    // umbrales, alertas, ventiladores, etc.) también la reutilice.
    // ---------------------------------------------------------
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.role == "administrador";
    }

    // ---------------------------------------------------------
    // Helper: isAdminOrOperator()
    //
    // Mismo criterio que isAdmin() (custom claim "role"), pero
    // también admite al rol "operador". El rol "consulta" queda
    // fuera: es de solo lectura.
    // ---------------------------------------------------------
    function isAdminOrOperator() {
      return request.auth != null &&
        request.auth.token.role in ["administrador", "operador"];
    }

    // ---------------------------------------------------------
    // Colección: usuarios/{uid}
    //
    // Lectura: el propio usuario autenticado, o cualquier
    // administrador (via custom claim "role").
    //
    // Escritura: exclusiva de administradores. La creación,
    // edición y desactivación de usuarios se hace siempre a
    // través de la Cloud Function "gestionarUsuario", nunca
    // por escritura directa del cliente.
    // ---------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.role == "administrador");

      allow write: if request.auth != null &&
        request.auth.token.role == "administrador";
    }

    // ---------------------------------------------------------
    // Colección: incubadoras/{id}
    //
    // Lectura: cualquier usuario autenticado (los tres roles
    // pueden consultar el estado de las incubadoras).
    //
    // Escritura: exclusiva de administradores. La creación,
    // edición y desactivación se hace siempre a través de la
    // Cloud Function "gestionarIncubadora", nunca por escritura
    // directa del cliente.
    // ---------------------------------------------------------
    match /incubadoras/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Colección: dispositivos/{id}
    //
    // Mismo criterio que incubadoras: lectura para cualquier
    // usuario autenticado, escritura exclusiva de administradores
    // y siempre a través de "gestionarIncubadora" (acción
    // "crear_dispositivo").
    // ---------------------------------------------------------
    match /dispositivos/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Fallback por defecto: cualquier documento no contemplado
    // explícitamente arriba queda denegado tanto en lectura
    // como en escritura.
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }



    // =====================================================
    // MEDICIONES
    // =====================================================
    //
    // Las mediciones:
    // - pueden ser leídas por cualquier usuario autenticado;
    // - nunca pueden ser escritas directamente desde el cliente.
    //
    // procesarMedicion utiliza Admin SDK, por lo que sus
    // escrituras no pasan por estas reglas.
    //

    match /mediciones/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // =====================================================
    // UMBRALES
    // =====================================================
    //
    // Los usuarios autenticados pueden consultar los umbrales.
    // Solo un administrador puede crearlos, modificarlos o
    // eliminarlos.
    //

    match /umbrales/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // ALERTAS
    // =====================================================
    //
    // Las alertas son creadas exclusivamente por
    // procesarMedicion mediante Admin SDK.
    //
    // El cliente puede leerlas, pero no puede crearlas.
    //
    // Solo un administrador u operador puede actualizar una
    // alerta (el rol "consulta" es de solo lectura), y
    // únicamente el campo "estado", que solo puede pasar a
    // "reconocida" o "resuelta" (ver ALERT_STATUS en
    // frontend/src/utils/constants.js).
    //

    match /alertas/{id} {
      allow read: if request.auth != null;

      allow create: if false;

      allow update: if isAdminOrOperator()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["estado"])
        && request.resource.data.estado in ["reconocida", "resuelta"];

      allow delete: if false;
    }

    // =====================================================
    // VENTILADORES
    // =====================================================
    //
    // Los usuarios autenticados pueden consultar los
    // ventiladores. Ningún cliente puede crearlos,
    // modificarlos ni eliminarlos: el estado (estadoActual)
    // lo escribe el Servicio de Integración o una Cloud
    // Function mediante Admin SDK, que no pasa por estas
    // reglas.
    //

    match /ventiladores/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // =====================================================
    // REGLAS DE AUTOMATIZACIÓN
    // =====================================================
    //
    // Los usuarios autenticados pueden consultar las reglas.
    // La escritura es siempre a través de la Cloud Function
    // "guardarReglaAutomatizacion", que valida la banda de
    // histéresis; nunca por escritura directa del cliente.
    //

    match /reglas_automatizacion/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // =====================================================
    // ÓRDENES DE VENTILADOR
    // =====================================================
    //
    // Los usuarios autenticados pueden consultar las órdenes.
    // Se crean únicamente desde Cloud Functions: las manuales con
    // "enviarComandoVentilador" y las automáticas con
    // "evaluarAutomatizacion" (dentro de "procesarMedicion"). Su
    // estado lo actualiza el Servicio de Integración. Todo con
    // Admin SDK.
    //

    match /ordenes_ventilador/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }



  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica si el usuario autenticado es administrador.
    // Ajusta esta función si tu proyecto ya tiene una implementación
    // de isAdmin() basada en roles o documentos de usuarios.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. ESTADÍSTICAS DIARIAS
    // Cualquier usuario autenticado puede leer.
    // Solo el servidor con Admin SDK puede escribir.
    match /estadisticas_diarias/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 2. AUDITORÍA
    // Solo administradores pueden consultar.
    // La escritura queda reservada al servidor.
    match /auditoria/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 3. ALERTAS
    match /alertas/{id} {
      allow read: if isAuthenticated();

      // La creación debe seguir la política existente
      // de tu proyecto.
      allow create: if false;

      // El cliente solo puede cambiar el estado y el campo
      // correspondiente al usuario que realizó la acción.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'estado',
            'reconocidaPor',
            'resueltaPor'
          ])
        && (
          (
            request.resource.data.estado == 'reconocida'
            && request.resource.data.reconocidaPor
              == request.auth.uid
            && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['resueltaPor'])
          )
          ||
          (
            request.resource.data.estado == 'resuelta'
            && request.resource.data.resueltaPor
              == request.auth.uid
            && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['reconocidaPor'])
          )
        );

      // La eliminación queda bloqueada desde el cliente.
      allow delete: if false;
    }

    // 4. UMBRALES
    // El usuario debe identificarse como autor del cambio.
    match /umbrales/{id} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.actualizadoPor
          == request.auth.uid;

      allow update: if isAuthenticated()
        && request.resource.data.actualizadoPor
          == request.auth.uid;

      allow delete: if false;
    }

    // Denegar el acceso a cualquier colección no declarada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

