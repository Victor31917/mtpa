rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // Helper: isAdmin()
    //
    // Reutilizado por todas las colecciones cuya escritura está
    // restringida a administradores (custom claim "role"). Se
    // define una sola vez acá para que Sprint 3 (mediciones,
    // umbrales, alertas, ventiladores, etc.) también la reutilice.
    // ---------------------------------------------------------
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.role == "administrador";
    }

    // ---------------------------------------------------------
    // Helper: isAdminOrOperator()
    //
    // Mismo criterio que isAdmin() (custom claim "role"), pero
    // también admite al rol "operador". El rol "consulta" queda
    // fuera: es de solo lectura.
    // ---------------------------------------------------------
    function isAdminOrOperator() {
      return request.auth != null &&
        request.auth.token.role in ["administrador", "operador"];
    }

    // ---------------------------------------------------------
    // Colección: usuarios/{uid}
    //
    // Lectura: el propio usuario autenticado, o cualquier
    // administrador (via custom claim "role").
    //
    // Escritura: exclusiva de administradores. La creación,
    // edición y desactivación de usuarios se hace siempre a
    // través de la Cloud Function "gestionarUsuario", nunca
    // por escritura directa del cliente.
    // ---------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.role == "administrador");

      allow write: if request.auth != null &&
        request.auth.token.role == "administrador";
    }

    // ---------------------------------------------------------
    // Colección: incubadoras/{id}
    //
    // Lectura: cualquier usuario autenticado (los tres roles
    // pueden consultar el estado de las incubadoras).
    //
    // Escritura: exclusiva de administradores. La creación,
    // edición y desactivación se hace siempre a través de la
    // Cloud Function "gestionarIncubadora", nunca por escritura
    // directa del cliente.
    // ---------------------------------------------------------
    match /incubadoras/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Colección: dispositivos/{id}
    //
    // Mismo criterio que incubadoras: lectura para cualquier
    // usuario autenticado, escritura exclusiva de administradores
    // y siempre a través de "gestionarIncubadora" (acción
    // "crear_dispositivo").
    // ---------------------------------------------------------
    match /dispositivos/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Fallback por defecto: cualquier documento no contemplado
    // explícitamente arriba queda denegado tanto en lectura
    // como en escritura.
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }



    // =====================================================
    // MEDICIONES
    // =====================================================
    //
    // Las mediciones:
    // - pueden ser leídas por cualquier usuario autenticado;
    // - nunca pueden ser escritas directamente desde el cliente.
    //
    // procesarMedicion utiliza Admin SDK, por lo que sus
    // escrituras no pasan por estas reglas.
    //

    match /mediciones/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // =====================================================
    // UMBRALES
    // =====================================================
    //
    // Los usuarios autenticados pueden consultar los umbrales.
    // Solo un administrador puede crearlos, modificarlos o
    // eliminarlos.
    //

    match /umbrales/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // ALERTAS
    // =====================================================
    //
    // Las alertas son creadas exclusivamente por
    // procesarMedicion mediante Admin SDK.
    //
    // El cliente puede leerlas, pero no puede crearlas.
    //
    // Solo un administrador u operador puede actualizar una
    // alerta (el rol "consulta" es de solo lectura), y
    // únicamente el campo "estado", que solo puede pasar a
    // "reconocida" o "resuelta" (ver ALERT_STATUS en
    // frontend/src/utils/constants.js).
    //

    match /alertas/{id} {
      allow read: if request.auth != null;

      allow create: if false;

      allow update: if isAdminOrOperator()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["estado"])
        && request.resource.data.estado in ["reconocida", "resuelta"];

      allow delete: if false;
    }
    // ============================================================ // Función para verificar si el usuario autenticado es admin // ============================================================ // Si isAdmin() YA EXISTE en tu archivo actual desde Sprint 2, // NO dupliques esta función. Conserva la versión existente. // // function isAdmin() { // return request.auth != null // && request.auth.token.rol == 'administrador'; // } // ============================================================ // VENTILADORES // ============================================================ // Los usuarios autenticados pueden consultar los ventiladores. // Ningún cliente puede crearlos, modificarlos ni eliminarlos. // El estadoActual será actualizado únicamente mediante // el Servicio de Integración utilizando Admin SDK. // match /ventiladores/{id} { allow read: if request.auth != null; allow write: if false; } // ============================================================ // REGLAS DE AUTOMATIZACIÓN // ============================================================ // Los usuarios autenticados pueden consultar las reglas. // Solamente los administradores pueden crearlas, modificarlas // o eliminarlas. // match /reglas_automatizacion/{id} { allow read: if request.auth != null; allow write: if isAdmin(); } // ============================================================ // ÓRDENES DE VENTILADOR // ============================================================ // Los usuarios autenticados pueden consultar las órdenes. // // La creación se realiza exclusivamente mediante: // - enviarComandoVentilador // - evaluación automática de procesarMedicion // // La actualización del estado de una orden la realiza // exclusivamente el Servicio de Integración mediante Admin SDK. // match /ordenes_ventilador/{id} { allow read: if request.auth != null; allow create: if false; allow update: if false; allow delete: if false; }
  }
}
