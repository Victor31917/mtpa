# =========================================================
# M.T.P.A. - Servicio de Integración IoT
# Variables de entorno (ver docs/broker-mqtt.md)
# =========================================================
#
# Copiar este archivo a ".env" (gitignoreado) y completar con
# las credenciales reales del cluster de HiveMQ Cloud. Nunca
# versionar el ".env" con valores reales.

MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mtpa-dev

# ---------------------------------------------------------
# procesarMedicion (Cloud Function HTTPS)
# ---------------------------------------------------------
# URL de la función desplegada (o del emulador) y token Bearer.
# PROCESAR_MEDICION_TOKEN debe tener el mismo valor que
# INTEGRATION_SERVICE_TOKEN en las Cloud Functions. Nunca
# versionar valores reales.

PROCESAR_MEDICION_URL=
PROCESAR_MEDICION_TOKEN=

# Opcionales (se muestran los valores por defecto):
# PROCESAR_MEDICION_MAX_REINTENTOS=5
# PROCESAR_MEDICION_BACKOFF_MS=500
